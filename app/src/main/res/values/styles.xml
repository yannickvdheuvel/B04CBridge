<resources>
    <style name="Theme.B04CBridge" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
    </style>

    <style name="Card">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- Kleine grijze kop boven een waarde. -->
    <style name="Label">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Value">
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">2dp</item>
    </style>
</resources>
