<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Kop -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:paddingTop="18dp" android:paddingBottom="14dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView
            android:text="B04C Bridge"
            android:textSize="22sp" android:textStyle="bold"
            android:textColor="@color/text"
            android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/build"
            style="@style/Label"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <ScrollView
        android:layout_weight="1"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:clipToPadding="false"
        android:layout_width="match_parent" android:layout_height="0dp">

        <LinearLayout android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content">

            <!-- Verbinding -->
            <com.google.android.material.card.MaterialCardView style="@style/Card"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:orientation="vertical" android:padding="18dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">

                    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:id="@+id/dot"
                            android:text="●" android:textSize="16sp"
                            android:textColor="@color/off"
                            android:paddingEnd="10dp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/statusTitle"
                            android:text="Niet verbonden"
                            android:textSize="17sp" android:textStyle="bold"
                            android:textColor="@color/text"
                            android:layout_weight="1"
                            android:layout_width="0dp" android:layout_height="wrap_content"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/connect"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:text="Verbind"
                            android:minWidth="0dp" android:minHeight="0dp"
                            android:paddingStart="18dp" android:paddingEnd="18dp"
                            android:insetTop="0dp" android:insetBottom="0dp"
                            android:layout_width="wrap_content" android:layout_height="40dp"/>
                    </LinearLayout>

                    <TextView android:id="@+id/status"
                        android:text="Wachten op het display…"
                        android:textSize="13sp" android:textColor="@color/muted"
                        android:paddingTop="10dp"
                        android:maxLines="2" android:ellipsize="end"
                        android:layout_width="match_parent" android:layout_height="wrap_content"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/notif"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:text="Meldingstoegang voor Maps en Komoot"
                        android:textAlignment="viewStart"
                        android:paddingStart="0dp"
                        android:insetTop="4dp" android:insetBottom="0dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Navigatie -->
            <com.google.android.material.card.MaterialCardView style="@style/Card"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:orientation="vertical" android:padding="18dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">

                    <TextView style="@style/Label" android:text="Naar het display"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingTop="10dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:id="@+id/navArrow"
                            android:text="–"
                            android:textSize="46sp"
                            android:textColor="@color/ok"
                            android:minWidth="62dp"
                            android:gravity="center"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <LinearLayout android:orientation="vertical"
                            android:paddingStart="8dp"
                            android:layout_weight="1"
                            android:layout_width="0dp" android:layout_height="wrap_content">
                            <TextView android:id="@+id/navTurn"
                                android:text="Geen navigatie"
                                android:textSize="22sp" android:textStyle="bold"
                                android:textColor="@color/text"
                                android:layout_width="match_parent" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/navRoute"
                                android:text="Start Google Maps of Komoot"
                                android:textSize="13sp" android:textColor="@color/muted"
                                android:paddingTop="2dp"
                                android:layout_width="match_parent" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Fietsdata -->
            <com.google.android.material.card.MaterialCardView style="@style/Card"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:orientation="vertical" android:padding="18dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">

                    <LinearLayout android:orientation="horizontal" android:gravity="bottom"
                        android:layout_width="match_parent" android:layout_height="wrap_content">
                        <LinearLayout android:orientation="vertical" android:layout_weight="1"
                            android:layout_width="0dp" android:layout_height="wrap_content">
                            <TextView style="@style/Label" android:text="Snelheid"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/speed"
                                android:text="–"
                                android:textSize="44sp" android:textStyle="bold"
                                android:textColor="@color/text"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <LinearLayout android:orientation="vertical" android:gravity="end"
                            android:paddingBottom="10dp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <TextView android:id="@+id/battery"
                                android:text="–"
                                android:textSize="19sp" android:textStyle="bold"
                                android:textColor="@color/ok"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/assist"
                                android:text="–"
                                android:textSize="13sp" android:textColor="@color/muted"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_marginTop="16dp" android:layout_marginBottom="14dp"
                        android:background="@color/stroke"
                        android:layout_width="match_parent" android:layout_height="1dp"/>

                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent" android:layout_height="wrap_content">
                        <LinearLayout android:orientation="vertical" android:layout_weight="1"
                            android:layout_width="0dp" android:layout_height="wrap_content">
                            <TextView style="@style/Label" android:text="Trip"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/trip" style="@style/Value" android:text="–"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <LinearLayout android:orientation="vertical" android:layout_weight="1"
                            android:layout_width="0dp" android:layout_height="wrap_content">
                            <TextView style="@style/Label" android:text="Odometer"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/odo" style="@style/Value" android:text="–"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:orientation="horizontal" android:paddingTop="14dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content">
                        <LinearLayout android:orientation="vertical" android:layout_weight="1"
                            android:layout_width="0dp" android:layout_height="wrap_content">
                            <TextView style="@style/Label" android:text="Gemiddeld"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/avg" style="@style/Value" android:text="–"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <LinearLayout android:orientation="vertical" android:layout_weight="1"
                            android:layout_width="0dp" android:layout_height="wrap_content">
                            <TextView style="@style/Label" android:text="Rijtijd"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/ridetime" style="@style/Value" android:text="–"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View android:layout_width="match_parent" android:layout_height="4dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Log -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Card"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:padding="14dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView style="@style/Label" android:text="Log"
                    android:layout_weight="1"
                    android:layout_width="0dp" android:layout_height="wrap_content"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toggleLog"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:text="Verberg"
                    android:minWidth="0dp" android:minHeight="0dp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    android:layout_width="wrap_content" android:layout_height="36dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/copyLog"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:text="Kopieer"
                    android:minWidth="0dp" android:minHeight="0dp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    android:layout_width="wrap_content" android:layout_height="36dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveLog"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:text="Bewaar"
                    android:minWidth="0dp" android:minHeight="0dp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    android:layout_width="wrap_content" android:layout_height="36dp"/>
            </LinearLayout>

            <ScrollView android:id="@+id/logScroll"
                android:layout_width="match_parent" android:layout_height="176dp">
                <TextView android:id="@+id/log"
                    android:textIsSelectable="true"
                    android:typeface="monospace"
                    android:textSize="11sp"
                    android:textColor="@color/muted"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </ScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
